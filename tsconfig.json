{
    "compilerOptions": {
        "strict": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "esModuleInterop": true,
        "declaration": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "useUnknownInCatchVariables": false,
        "preserveConstEnums": true,
        "outDir": "dist",
        "rootDir": ".",
        "sourceMap": false,
        "skipLibCheck": true
    },
    "include": [
        "credentials/**/*",
        "nodes/**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "test"
    ]
}